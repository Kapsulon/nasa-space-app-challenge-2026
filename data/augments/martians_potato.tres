[resource]
script = ExtResource("1_aug")
display_name = "The Martian's Potato"
short_name = "Martian's Potato"
image = ExtResource("2_img")
weight = 0.2
type = 0
rarity = 0
domain = 3
card_type = 3
daily = Dictionary[String, int]({"food": 1, "water": -1})
risks = Array[ExtResource("3_risk")]([SubResource("Risk_0"), SubResource("Risk_1")])
gives_text = "+1 meal per day"
costs_text = "Consumes extra Water each day"
risks_text = "Risk of diarrhea (it grew in homemade fertilizer). If Water runs short (below 10 L) the plant dies and production stops"
synergy_text = "Competes with the crew for the Water supply"
lore = "Potatoes are one of the crops studied for space farming: they give a lot of calories for little room. The International Potato Center and NASA grew them in a box that mimics Martian conditions. Real Martian soil holds toxic salts called perchlorates, so it would have to be washed before anything could grow in it."
