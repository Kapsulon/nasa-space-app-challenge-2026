[resource]
script = ExtResource("1_aug")
display_name = "Bargain Freeze-Dried Meal Pouches"
short_name = "Meal Pouches"
image = ExtResource("2_img")
weight = 0.4
type = 0
rarity = 0
domain = 3
card_type = 0
upgrades = Dictionary[String, String]({"food": "25", "water": "-12"})
