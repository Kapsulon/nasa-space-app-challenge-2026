[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
label = "Overhaul it with spare parts"
cost = Dictionary[String, int]({"power": 2})
success_chance = 0.8
success_effects = Dictionary[String, int]({"water": 4})
success_text = "The recycler is running better than ever."
