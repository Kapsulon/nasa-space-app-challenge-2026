failure_text = "The overhaul didn't work and some water spilled. The engineer is frustrated."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
label = "Flush and bypass it"
cost = Dictionary[String, int]({})
