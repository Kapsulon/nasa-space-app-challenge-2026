[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
label = "Burn now"
cost = Dictionary[String, int]({"power": 4})
success_chance = 0.7
success_effects = Dictionary[String, int]({"mission_days": -1, "crew_stress": -10})
success_text = "Perfect burn! You will reach the station a day early. The crew cheers."
failure_effects = Dictionary[String, int]({"hull": -10, "crew_stress": 10})
failure_text = "The engine rattled and the burn was cancelled. The hull got shaken up."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
label = "Wait for the planned window"
cost = Dictionary[String, int]({})
success_chance = 1.0
success_effects = Dictionary[String, int]({})
success_text = "You stayed on the planned path. Slow and steady."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[resource]
script = ExtResource("1_event")
title = "Early docking window"
description = "Mission control says the space station is adjusting its orbit. An engine burn right now could get you there a day early."
min_day = 4
weight = 0.7
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
