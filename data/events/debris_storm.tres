[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_0"]
script = ExtResource("2_choice")
label = "Execute emergency evasive maneuvers"
cost = Dictionary[String, int]({"power": 5})
needs_crew = false
work_hours = 2.0
success_chance = 1.0
success_effects = Dictionary[String, int]({})
success_text = "A hard burn and a sharp turn: not a scratch."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Cross your fingers and let the hull take the hits"
cost = Dictionary[String, int]({})
needs_crew = false
work_hours = 2.0
success_chance = 0.5
success_effects = Dictionary[String, int]({"hull": -8})
success_text = "Ping, ping, ping. A few dents in the hull, nothing worse."
failure_effects = Dictionary[String, int]({"hull": -8, "lose_any": 1})
failure_text = "A bigger piece tore off one of the modules!"

[resource]
script = ExtResource("1_event")
title = "Orbital Debris Storm"
description = "You are passing through a zone of defunct satellites and rocket debris. A shower of micro-impacts pelts the hull."
min_day = 3
weight = 1.0
skill = "command"
location = "hull"
tags = Array[StringName]([&"hazard"])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_0"), SubResource("Choice_1")])
