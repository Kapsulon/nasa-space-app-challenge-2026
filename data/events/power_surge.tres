[resource]
script = ExtResource("1_event")
title = "Grid Power Surge"
description = "Following a sudden shift in solar irradiance, an electrical voltage spike surges through the ship and blows the main fuses."
min_day = 2
weight = 1.0
skill = "engineering"
location = "engineering"
tags = Array[StringName]([&"hazard"])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_0"), SubResource("Choice_1")])
