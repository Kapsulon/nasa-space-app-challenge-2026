[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
work_hours = 1.5
label = "Fire the thrusters and dodge it"
cost = Dictionary[String, int]({"power": 2})
success_chance = 0.75
success_effects = Dictionary[String, int]({"crew_stress": -3})
success_text = "A gentle nudge of the thrusters and the junk drifted harmlessly past the window. Nice flying!"
failure_effects = Dictionary[String, int]({"hull": -8, "crew_stress": 5})
failure_text = "The dodge came a little late: a few bits of junk pinged off the hull."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
needs_crew = false
label = "Turn the shielded side towards it"
cost = Dictionary[String, int]({})
success_chance = 1.0
success_effects = Dictionary[String, int]({"hull": -12, "crew_stress": 4})
success_text = "The shield took the hits. Noisy, but everyone is fine."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[resource]
script = ExtResource("1_event")
title = "Space debris ahead"
description = "Radar picked up a cloud of old satellite fragments crossing the ship's path. Even a tiny bolt flies faster than a bullet up here."
min_day = 2
weight = 1.0
skill = "command"
location = "outside"
tags = Array[StringName]([&"hazard"])
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
