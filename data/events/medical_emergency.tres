[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
label = "Use a medkit"
cost = Dictionary[String, int]({"medkits": 1})
success_chance = 0.9
success_effects = Dictionary[String, int]({})
success_text = "The flight surgeon fixed it right up. Big smiles again!"
failure_effects = Dictionary[String, int]({"random_crew_health": -10})
failure_text = "The medkit only helped a little."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
label = "Wait and see"
cost = Dictionary[String, int]({})
success_chance = 0.4
success_effects = Dictionary[String, int]({})
success_text = "The ache faded overnight. Phew!"
failure_effects = Dictionary[String, int]({"random_crew_health": -20, "random_crew_stress": 15})
failure_text = "The toothache kept them up all night."

[resource]
script = ExtResource("1_event")
title = "Space toothache"
description = "A crew member woke up with a really bad toothache. There is no dentist in orbit!"
min_day = 2
weight = 0.9
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
