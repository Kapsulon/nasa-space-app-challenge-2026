[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
label = "Hold a crew meeting"
cost = Dictionary[String, int]({})
success_chance = 0.7
success_effects = Dictionary[String, int]({"crew_stress": -15})
success_text = "Everyone agreed on a playlist rotation. The mood is much better!"
failure_effects = Dictionary[String, int]({"crew_stress": 10})
failure_text = "The meeting went around in circles. Everyone went to bed a bit grumpy."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
label = "Let them sort it out"
cost = Dictionary[String, int]({})
success_chance = 0.5
success_effects = Dictionary[String, int]({})
success_text = "They worked it out on their own and now share headphones."
failure_effects = Dictionary[String, int]({"crew_stress": 15})
failure_text = "The disagreement dragged on and the whole crew felt the tension."

[resource]
script = ExtResource("1_event")
title = "Playlist dispute"
description = "Living in a small capsule is hard. Two crew members can't agree on what music to play in the cabin, and the mood is getting tense."
min_day = 3
weight = 0.8
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
