[resource]
script = ExtResource("1_event")
title = "Micrometeorite or Pest Invasion"
description = "Metallic residues and microscopic space dust have infiltrated the ventilation ducts and are chewing through the insulation of your Energy cards."
min_day = 3
weight = 1.0
skill = "engineering"
location = "engineering"
tags = Array[StringName]([&"hazard"])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_0"), SubResource("Choice_1")])
