failure_text = "The vibrations stopped, but the ship lost speed: the trip is one day longer."

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Ignore the vibrations and push the throttle"
cost = Dictionary[String, int]({})
needs_crew = false
work_hours = 2.0
success_chance = 0.5
success_effects = Dictionary[String, int]({})
success_text = "The resonance faded at full power. Smooth flying again."
failure_effects = Dictionary[String, int]({"hull": -15, "crew_stress": 8})
failure_text = "Something cracked in the engine mount. The hull took a beating."

[resource]
script = ExtResource("1_event")
title = "Abnormal Reactor Vibration"
description = "The rocket begins shaking abnormally. The main thruster appears to be entering resonance."
