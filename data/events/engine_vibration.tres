[sub_resource type="Resource" id="Choice_0"]
script = ExtResource("2_choice")
label = "Cut the engines abruptly"
cost = Dictionary[String, int]({})
needs_crew = false
work_hours = 2.0
success_chance = 0.5
success_effects = Dictionary[String, int]({"crew_stress": 3})
