[resource]
script = ExtResource("1_event")
title = "Drifting supply pod"
description = "A supply pod lost during an earlier delivery is floating within reach of the robotic arm."
min_day = 2
weight = 0.8
skill = "engineering"
location = "outside"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
