[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Choice_0"]
script = ExtResource("2_choice")
label = "Reprogram the entertainment system"
cost = Dictionary[String, int]({})
needs_crew = true
work_hours = 2.0
success_chance = 0.7
success_effects = Dictionary[String, int]({"crew_stress": -10})
success_text = "The loop is fixed. Only the hum of the machinery remains. Blissful."
failure_effects = Dictionary[String, int]({"crew_stress": 6})
failure_text = "The reboot made it louder. And it skips now."

[sub_resource type="Resource" id="Choice_1"]
script = ExtResource("2_choice")
label = "Smash the screen with a wrench"
cost = Dictionary[String, int]({})
needs_crew = false
work_hours = 2.0
success_chance = 1.0
success_effects = Dictionary[String, int]({"crew_stress": -4})
success_text = "Silence! Sweet relief... until everyone realizes there's no more entertainment."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[sub_resource type="Resource" id="Choice_2"]
script = ExtResource("2_choice")
label = "Wait for it to stop on its own"
cost = Dictionary[String, int]({})
needs_crew = false
work_hours = 2.0
success_chance = 1.0
success_effects = Dictionary[String, int]({"crew_stress": 12})
success_text = "It did not stop on its own. Space jazz, forever."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[resource]
script = ExtResource("1_event")
title = "The Infernal Audio Loop"
description = "The onboard entertainment system crashed. The exact same space-jazz song has been playing on loop for 48 hours straight. The crew is starting to lose their minds."
min_day = 2
weight = 1.0
skill = "engineering"
location = "galley"
tags = Array[StringName]([&"isolation"])
choices = Array[ExtResource("2_choice")]([SubResource("Choice_0"), SubResource("Choice_1"), SubResource("Choice_2")])
