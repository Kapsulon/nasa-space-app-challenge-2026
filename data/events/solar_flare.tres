[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
needs_crew = false
label = "Shelter in the shielded core"
cost = Dictionary[String, int]({"power": 1})
success_chance = 1.0
success_effects = Dictionary[String, int]({"science": -1, "crew_stress": 5})
success_text = "Everyone hunkered down and played cards until the flare passed. A few experiments have to be restarted."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
needs_crew = false
label = "Keep working through it"
cost = Dictionary[String, int]({})
success_chance = 0.5
success_effects = Dictionary[String, int]({"science": 2})
success_text = "The flare was weaker than predicted. The extra work paid off!"
failure_effects = Dictionary[String, int]({"crew_health": -10, "crew_stress": 20})
failure_text = "The flare was stronger than expected and everyone had to rush to the shelter. The crew is tired and a little shaken."

[resource]
script = ExtResource("1_event")
title = "Solar flare warning"
description = "Space weather forecast: the Sun is about to send out a big burst of energy. The shielded core of the ship is the safest place to be."
min_day = 2
weight = 1.0
skill = "engineering"
location = "engineering"
tags = Array[StringName]([&"hazard"])
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
