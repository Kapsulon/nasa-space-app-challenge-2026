[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
work_hours = 3.0
label = "Send someone on a spacewalk to patch it"
cost = Dictionary[String, int]({"power": 2})
success_chance = 0.75
success_effects = Dictionary[String, int]({"hull": 5})
success_text = "The spacewalk patch held. The service module is sealed and cosy again."
failure_effects = Dictionary[String, int]({"hull": -10, "random_crew_health": -20, "random_crew_stress": 15})
failure_text = "The patch didn't stick, and the spacewalker came back inside worn out."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
needs_crew = false
label = "Close the hatch and seal the module off"
cost = Dictionary[String, int]({})
success_chance = 1.0
success_effects = Dictionary[String, int]({"hull": -15, "oxygen": -3, "crew_stress": 5})
success_text = "The crew lost a bit of room and some air, but nobody had to go outside."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[resource]
script = ExtResource("1_event")
title = "Micrometeoroid strike"
description = "A tiny space pebble, smaller than a grain of rice, poked a hole in the service module. The air is slowly leaking out."
min_day = 2
weight = 1.2
skill = "engineering"
location = "hull"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
