[gd_resource type="Resource" script_class="MissionEvent" format=3]

[ext_resource type="Script" uid="uid://biefsdrors6uu" path="res://classes/mission_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://d17r2hc2mlxap" path="res://classes/event_choice.gd" id="2_choice"]

[sub_resource type="Resource" id="Resource_choice0"]
script = ExtResource("2_choice")
label = "Send someone on EVA to patch it"
cost = Dictionary[String, int]({"power": 2})
success_chance = 0.75
success_effects = Dictionary[String, int]({"hull": 5})
success_text = "The EVA patch held. The service module is sealed again."
failure_effects = Dictionary[String, int]({"hull": -10, "random_crew_health": -30})
failure_text = "The patch tore loose during the EVA. The hull took more damage and the spacewalker was hurt."

[sub_resource type="Resource" id="Resource_choice1"]
script = ExtResource("2_choice")
label = "Seal the module off"
cost = Dictionary[String, int]({})
success_chance = 1.0
success_effects = Dictionary[String, int]({"hull": -15, "oxygen": -3})
success_text = "You lost access to the module and some air, but nobody was put at risk."
failure_effects = Dictionary[String, int]({})
failure_text = ""

[resource]
script = ExtResource("1_event")
title = "Micrometeoroid strike"
description = "A pebble-sized micrometeoroid punctured the service module. Cabin pressure is dropping slowly."
min_day = 2
weight = 1.2
choices = Array[ExtResource("2_choice")]([SubResource("Resource_choice0"), SubResource("Resource_choice1")])
